# Copy to .env, then replace every value marked REPLACE_ME.
TZ=Asia/Shanghai
CLOUDHELM_APP_NAME="云舵 Cloud Helm"
CLOUDHELM_AGENT_ENROLLMENT_TOKEN=REPLACE_ME_WITH_A_SEPARATE_RANDOM_TOKEN
CLOUDHELM_PUBLIC_BASE_URL=https://ops.example.com
CLOUDHELM_WECOM_CORP_ID=REPLACE_ME_WITH_WECOM_CORP_ID
CLOUDHELM_WECOM_AGENT_ID=REPLACE_ME_WITH_WECOM_AGENT_ID
CLOUDHELM_WECOM_SECRET=REPLACE_ME_WITH_WECOM_APP_SECRET
# 启用企业自用小程序时取消下一行注释，并填写关联小程序在当前企业下的 Secret。
# CLOUDHELM_WECOM_MINIPROGRAM_SECRET=REPLACE_ME_WITH_WECOM_MINIPROGRAM_SECRET
CLOUDHELM_WECOM_API_TIMEOUT_SECONDS=8
CLOUDHELM_WECOM_API_BASE=https://qyapi.weixin.qq.com
CLOUDHELM_BOOTSTRAP_ADMIN_WECOM_USERID=REPLACE_ME_WITH_ADMIN_WECOM_USERID
CLOUDHELM_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
CLOUDHELM_DATABASE_URL=sqlite:////data/cloudhelm.db
CLOUDHELM_ENVIRONMENT=production
CLOUDHELM_SESSION_MINUTES=60
CLOUDHELM_MAX_SESSIONS_PER_USER=5
CLOUDHELM_OAUTH_STATE_SECONDS=300
CLOUDHELM_NODE_OFFLINE_SECONDS=60
CLOUDHELM_MAX_TASK_RESULT_BYTES=262144
CLOUDHELM_METRICS_HISTORY_ENABLED=true
CLOUDHELM_METRICS_HISTORY_INTERVAL_SECONDS=300
CLOUDHELM_METRICS_HISTORY_RETENTION_HOURS=168
CLOUDHELM_METRICS_HISTORY_MAX_ROWS=200000
# 告警事件只在“触发”和“恢复”时写入；默认保留 90 天，且最多 10000 行。
CLOUDHELM_ALERTS_ENABLED=true
CLOUDHELM_ALERT_EVENT_RETENTION_HOURS=2160
CLOUDHELM_ALERT_EVENT_MAX_ROWS=10000
# 企微应用消息的全局开关；接收人和资源订阅在 H5“用户 → 权限与告警”中配置。
CLOUDHELM_ALERT_NOTIFICATIONS_ENABLED=false
CLOUDHELM_TRUST_PROXY_HEADERS=true
CLOUDHELM_BIND_ADDRESS=127.0.0.1
CLOUDHELM_PORT=8080
