page{background:#f2f7f7;color:#102c37;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx}.page{padding:30rpx 28rpx 54rpx}.hero{padding:18rpx 4rpx 30rpx}.eyebrow{font-size:20rpx;letter-spacing:4rpx;color:#169b8f;font-weight:700}.title{font-size:48rpx;font-weight:800;margin-top:8rpx}.subtitle{font-size:25rpx;color:#738890;margin-top:8rpx;line-height:1.6}.card{background:#fff;border:1rpx solid #dfeaea;border-radius:26rpx;padding:28rpx;margin-bottom:18rpx;box-shadow:0 12rpx 30rpx rgba(12,51,62,.045)}.section-title{font-size:31rpx;font-weight:750;margin:30rpx 4rpx 18rpx}.metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.metric{background:#fff;border-radius:24rpx;padding:26rpx;border:1rpx solid #e1ebeb}.metric-label{font-size:22rpx;color:#7b8f96}.metric-value{display:block;font-size:45rpx;font-weight:800;margin-top:8rpx}.metric-note{display:block;font-size:20rpx;color:#83959b;margin-top:4rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.row-main{min-width:0;flex:1}.row-title{font-size:29rpx;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.row-subtitle{display:block;font-size:21rpx;color:#7a8e95;margin-top:6rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.badge{font-size:20rpx;padding:8rpx 14rpx;border-radius:999rpx;background:#e3f5f1;color:#168e82;white-space:nowrap}.badge.offline{background:#edf0f1;color:#89969a}.button{background:#0c3142!important;color:#fff!important;border-radius:18rpx!important;font-size:26rpx!important;line-height:84rpx!important;margin:16rpx 0!important}.button.secondary{background:#e3eeee!important;color:#174151!important}.button.danger{background:#c64e4e!important}.button::after{border:0}.empty{text-align:center;color:#85969c;padding:70rpx 20rpx}.error{background:#fff0ed;color:#a94438;border-radius:18rpx;padding:22rpx;margin-bottom:18rpx;font-size:23rpx;line-height:1.6}.loading{text-align:center;color:#7d9097;padding:80rpx}.field{margin-bottom:22rpx}.field-label{display:block;font-size:22rpx;color:#738890;margin-bottom:10rpx}.input,.picker{background:#f5f9f9;border:1rpx solid #dbe7e7;border-radius:16rpx;padding:22rpx}.divider{height:1rpx;background:#e6eeee;margin:24rpx 0}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.gpu{border-left:6rpx solid #69b928}.danger-text{color:#b74242}.muted{color:#7d9097}.hidden{display:none}
