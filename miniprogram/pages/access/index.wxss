.access-page{padding-bottom:150rpx}.access-row{display:grid;grid-template-columns:auto minmax(0,1fr);gap:16rpx;align-items:center;padding:22rpx}.access-row picker{grid-column:2}.access-row.depth-1{margin-left:14rpx}.access-row.depth-2{margin-left:28rpx}.access-row.depth-3{margin-left:42rpx}.level{background:#edf5f4;color:#23665f;border-radius:12rpx;padding:14rpx;font-size:21rpx}.level.disabled{opacity:.45}.save{position:fixed;z-index:10;left:28rpx;right:28rpx;bottom:24rpx;box-shadow:0 10rpx 30rpx rgba(5,30,42,.2)}
