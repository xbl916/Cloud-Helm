.gpu-stats{display:flex;flex-wrap:wrap;gap:18rpx;color:#71868d;font-size:21rpx;margin-top:20rpx}.state{width:15rpx;height:15rpx;border-radius:50%;background:#9da9ac;flex:none}.state.running{background:#39ad73;box-shadow:0 0 0 7rpx #e4f5ec}.arrow{font-size:44rpx;color:#91a0a5}.gpu-label{display:inline-block;margin-top:10rpx;padding:5rpx 10rpx;border-radius:10rpx;background:#edf8e8;color:#559327;font-size:19rpx}
