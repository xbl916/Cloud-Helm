.metric-value.small{font-size:30rpx;word-break:break-all}.details>view{display:grid;grid-template-columns:170rpx 1fr;gap:20rpx;padding:17rpx 0;border-bottom:1rpx solid #edf2f2;font-size:22rpx}.details>view>text:first-child{color:#7d9097}.details>view>text:last-child{word-break:break-all}.logs-mask{position:fixed;inset:0;background:rgba(2,18,27,.68);z-index:50;padding:80rpx 24rpx 30rpx}.logs-panel{height:calc(100% - 110rpx);background:#f5f8f8;border-radius:28rpx;padding:28rpx;display:flex;flex-direction:column}.logs{flex:1;background:#071921;color:#d8e9e9;border-radius:18rpx;margin:22rpx 0;padding:22rpx;box-sizing:border-box;font:21rpx/1.6 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre-wrap}.close{font-size:48rpx;color:#61777f;padding:0 8rpx}
.image-update{margin-top:20rpx}.image-update .row-subtitle{display:block;margin-top:10rpx;line-height:1.6;word-break:break-all}.tag-input{height:76rpx;margin-top:20rpx;padding:0 20rpx;border:1rpx solid #d9e5e7;border-radius:16rpx;background:#f8fbfb;font-size:24rpx;box-sizing:border-box}.image-update .button{margin-top:16rpx}
